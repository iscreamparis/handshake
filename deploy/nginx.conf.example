server {
    listen 80;
    server_name rooms.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name rooms.example.com;

    ssl_certificate /etc/letsencrypt/live/rooms.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rooms.example.com/privkey.pem;

    # /ws also serves the GameNet relay (RELAY_PATH = '/ws').
    location /ws {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 75s;
    }

    # When RELAY_PATH is not '/ws', uncomment and point the exact path at the
    # relay. It is the same upgrade-capable block as /ws above.
    # location = /RELAY_PATH {
    #     proxy_pass http://127.0.0.1:8787;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection "upgrade";
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_read_timeout 75s;
    # }

    location /health {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

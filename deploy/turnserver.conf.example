# coturn for the kart rooms server (same VM). Copy to /etc/turnserver.conf.
listening-port=3478
tls-listening-port=5349

# TURN REST credentials: static-auth-secret must equal TURN_SECRET.
use-auth-secret
static-auth-secret=CHANGE_ME
realm=rooms.example.com

cert=/etc/letsencrypt/live/rooms.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/rooms.example.com/privkey.pem

# Relay range (open 49152-65535 UDP in the firewall).
min-port=49152
max-port=65535

no-multicast-peers
fingerprint

# Never relay to private or local networks.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# /etc/kart-rooms.env: environment of the rooms server (systemd EnvironmentFile).

# Plain HTTP/WS port and address; TLS is terminated by Caddy or nginx.
PORT=8787
HOST=127.0.0.1

# Comma-separated STUN urls sent to clients.
STUN_URLS=stun:stun.l.google.com:19302

# Comma-separated TURN urls (coturn on this VM); used only with TURN_SECRET.
TURN_URLS=turn:rooms.example.com:3478?transport=udp,turn:rooms.example.com:3478?transport=tcp,turns:rooms.example.com:5349?transport=tcp

# Must equal static-auth-secret in turnserver.conf. Empty disables TURN.
TURN_SECRET=CHANGE_ME

# Capacity limits.
MAX_ROOMS=500
MAX_CLIENTS=2000

# Comma-separated allowed Origin values for /ws. Empty allows any origin.
ALLOWED_ORIGINS=https://game.example.com

# error, info or debug.
LOG_LEVEL=info
